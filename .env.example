# Manteion Control Plane Configuration

# --- Server ---
# Address to bind the Manteion API server.
MANTEION_ADDR=:9090

# --- Database ---
# PostgreSQL connection string.
MANTEION_DATABASE_URL=postgres://manteion:manteion@localhost:5432/manteion?sslmode=disable

# --- Integration ---
# Base URL for the zeus-go / Archer workflow execution plane.
ZEUS_URL=http://localhost:8080

# Base URL for the Prometheus metrics server.
PROMETHEUS_URL=http://localhost:9090

# Directory for persistent file storage (e.g. cachebox replay artifacts).
CACHE_DIR=./data/cache

# --- SDK Management ---
# Set to 'true' to auto-delete SDK instances dead for > 10 minutes.
MANTEION_SDK_PURGE_ENABLED=false

# --- CORS ---
# Allowed origins for API requests (default: *).
CORS_ALLOWED_ORIGINS=*
