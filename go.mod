module manteion-go

go 1.27.3

require (
	git.ucsc.edu/microfaults/atropos-go v0.1.0
	github.com/google/uuid v1.6.0
	github.com/jackc/pgx/v5 v5.13.0
	github.com/open-policy-agent/opa v1.22.4
	go.opentelemetry.io/otel/trace v1.47.0
