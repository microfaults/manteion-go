module manteion-go

go 1.25.5

require (
	git.ucsc.edu/microfaults/atropos-go v0.0.8-0.20260518024008-a1ba3ac6313f
	github.com/google/uuid v1.6.0
	github.com/jackc/pgx/v5 v5.7.4
